# .env.local.example
# Copy to .env.local and fill in values

# Payload CMS secret (generate with: openssl rand -base64 32)
PAYLOAD_SECRET=your-secret-here

# MongoDB connection string
# Local: mongodb://localhost:27017/reddyontheroad
# Atlas: mongodb+srv://user:pass@cluster.mongodb.net/reddyontheroad
DATABASE_URI=mongodb://localhost:27017/reddyontheroad
